ARG NODE_IMAGE=node:24.16.0-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203
ARG GOTENBERG_IMAGE=gotenberg/gotenberg:8.37.0@sha256:f29984bd1e226bf1b93ba90af06000afa8b315853e99d27b9aaa41b93f15c769
FROM ${GOTENBERG_IMAGE} AS bundled-fonts
USER root
COPY docker/fonts/manage.py docker/fonts/sources.lock.json /opt/imprint-font-tools/
COPY docker/fonts/licenses /opt/imprint-font-tools/licenses/
RUN --mount=type=cache,id=imprint-font-downloads,sharing=locked,target=/var/cache/imprint-fonts \
    python3 /opt/imprint-font-tools/manage.py install --destination /opt/imprint-fonts

FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig*.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM ${GOTENBERG_IMAGE} AS patched-pdfcpu
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
COPY docker/install-pdfcpu.sh /tmp/install-pdfcpu.sh
RUN sh /tmp/install-pdfcpu.sh

FROM ${GOTENBERG_IMAGE}
USER root
WORKDIR /app
COPY --from=patched-pdfcpu /usr/bin/pdfcpu /usr/bin/pdfcpu
COPY --from=bundled-fonts /opt/imprint-fonts /usr/local/share/fonts/imprint/google/
COPY docker/fonts/custom /usr/local/share/fonts/imprint/custom/
COPY docker/fonts/manage.py docker/fonts/sources.lock.json docker/fonts/carbone-cloud-font-list.txt /usr/local/lib/imprint-fonts/
ARG REQUIRED_FONTS=Roboto,Lobster,Open\ Sans,Noto\ Sans
RUN fc-cache -f && python3 /usr/local/lib/imprint-fonts/manage.py inventory --require "$REQUIRED_FONTS"
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build --chown=gotenberg:gotenberg /app/node_modules ./node_modules
COPY --from=build --chown=gotenberg:gotenberg /app/dist ./dist
COPY --chown=gotenberg:gotenberg package.json ./
RUN mkdir -p /data && chown gotenberg:gotenberg /data && chmod 700 /data
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 IMPRINT_DATA_DIR=/data XDG_CONFIG_HOME=/tmp/config XDG_CACHE_HOME=/tmp/cache LIBREOFFICE_AUTO_START=true LIBREOFFICE_START_TIMEOUT=60s
LABEL org.opencontainers.image.title="imprint-doc-gen" org.opencontainers.image.source="https://github.com/KenPrz/imprint-doc-gen" org.opencontainers.image.description="Standalone Office document and PDF generation API with durable jobs"
USER gotenberg
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/standalone.js"]
