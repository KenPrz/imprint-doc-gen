ARG GOTENBERG_IMAGE=gotenberg/gotenberg:8.37.0@sha256:f29984bd1e226bf1b93ba90af06000afa8b315853e99d27b9aaa41b93f15c769
FROM ${GOTENBERG_IMAGE} AS bundled-fonts
USER root
COPY docker/fonts/manage.py docker/fonts/sources.lock.json /opt/imprint-font-tools/
COPY docker/fonts/licenses /opt/imprint-font-tools/licenses/
RUN --mount=type=cache,id=imprint-font-downloads,sharing=locked,target=/var/cache/imprint-fonts \
    python3 /opt/imprint-font-tools/manage.py install --destination /opt/imprint-fonts

# Debian font packages plus static faces generated from the variable fonts above
# for Carbone reference names that no installed font provides.
FROM ${GOTENBERG_IMAGE} AS generated-fonts
USER root
COPY docker/fonts/manage.py docker/fonts/sources.lock.json docker/fonts/carbone-cloud-font-list.txt docker/fonts/debian-packages.txt /opt/imprint-font-tools/
# Bind-mounted, not copied: a copy would add a 2.5 GB build layer.
RUN --mount=type=bind,from=bundled-fonts,source=/opt/imprint-fonts,target=/usr/local/share/fonts/imprint/google \
    apt-get update && xargs -a /opt/imprint-font-tools/debian-packages.txt apt-get install -y --no-install-recommends python3-fonttools \
    && fc-cache -f && python3 /opt/imprint-font-tools/manage.py generate --source /usr/local/share/fonts/imprint/google --output /opt/imprint-generated

# Optional Microsoft fonts, downloaded from Microsoft at build time. Keep images built with
# MICROSOFT_FONTS=true private: the licenses allow installation, not redistribution.
FROM ${GOTENBERG_IMAGE} AS microsoft-fonts
USER root
ARG MICROSOFT_FONTS=false
COPY docker/fonts/microsoft-fonts.sh /opt/imprint-font-tools/
RUN MICROSOFT_FONTS=$MICROSOFT_FONTS sh /opt/imprint-font-tools/microsoft-fonts.sh /opt/microsoft-fonts

FROM ${GOTENBERG_IMAGE} AS patched-pdfcpu
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
# Release asset digests are published by github.com/pdfcpu/pdfcpu/releases/tag/v0.16.1.
COPY docker/install-pdfcpu.sh /tmp/install-pdfcpu.sh
RUN sh /tmp/install-pdfcpu.sh

FROM ${GOTENBERG_IMAGE}
USER root
COPY --from=patched-pdfcpu /usr/bin/pdfcpu /usr/bin/pdfcpu
COPY --from=bundled-fonts /opt/imprint-fonts /usr/local/share/fonts/imprint/google/
COPY docker/fonts/debian-packages.txt /tmp/debian-font-packages.txt
RUN apt-get update && xargs -a /tmp/debian-font-packages.txt apt-get install -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
COPY --from=generated-fonts /opt/imprint-generated /usr/local/share/fonts/imprint/generated/
COPY --from=microsoft-fonts /opt/microsoft-fonts /usr/local/share/fonts/microsoft/
COPY docker/fonts/custom /usr/local/share/fonts/imprint/custom/
COPY docker/fonts/manage.py docker/fonts/sources.lock.json docker/fonts/carbone-cloud-font-list.txt /usr/local/lib/imprint-fonts/
ARG REQUIRED_FONTS=Roboto,Lobster,Open\ Sans,Noto\ Sans
RUN fc-cache -f && python3 /usr/local/lib/imprint-fonts/manage.py inventory --require "$REQUIRED_FONTS"
# Load the large catalog before health succeeds, not inside the first request.
ENV LIBREOFFICE_AUTO_START=true LIBREOFFICE_START_TIMEOUT=60s
USER gotenberg
