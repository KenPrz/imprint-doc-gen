ARG GOTENBERG_IMAGE=gotenberg/gotenberg:8.37.0@sha256:f29984bd1e226bf1b93ba90af06000afa8b315853e99d27b9aaa41b93f15c769
FROM ${GOTENBERG_IMAGE} AS patched-pdfcpu
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
# Release asset digests are published by github.com/pdfcpu/pdfcpu/releases/tag/v0.16.1.
COPY docker/install-pdfcpu.sh /tmp/install-pdfcpu.sh
RUN sh /tmp/install-pdfcpu.sh

FROM ${GOTENBERG_IMAGE}
COPY --from=patched-pdfcpu /usr/bin/pdfcpu /usr/bin/pdfcpu
USER gotenberg
